# Auto detect text files and perform LF normalization
* text=auto

# Firmware images are binary, and Intel HEX files keep their bytes as published
# (the copies in public/firmware are meant to match the release assets exactly).
*.bin binary
*.elf binary
*.hex -text

# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Signed release companions keep their exact bytes (a signature covers them).
public/firmware/*.sig -text
public/firmware/*.sha256 -text
public/firmware/*.manifest.json -text
public/firmware/firmware_manifest.json -text
