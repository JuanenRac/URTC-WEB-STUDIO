  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
