    "lucide-react": "^1.64.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.0.0",
